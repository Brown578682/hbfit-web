generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── AUTH ───────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── USERS & MEMBERS ────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          Role      @default(MEMBER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  member   Member?
  staff    Staff?
}

enum Role {
  MEMBER
  STAFF
  ADMIN
}

model Member {
  id              String        @id @default(cuid())
  userId          String        @unique
  firstName       String
  lastName        String
  phone           String?
  phone2          String?
  email2          String?
  dateOfBirth     DateTime?
  address         String?
  city            String?
  state           String?
  zip             String?
  gender          String?
  gymDeskId       String?       // legacy GymDesk ID for migrated members
  checkInCode     String?       @unique
  source          String?       // how they found HBFIT
  notes           String?       @db.Text
  joinedAt        DateTime      @default(now())
  lastVisit       DateTime?
  status          MemberStatus  @default(ACTIVE)

  // GAP Program verification
  gapEligible     Boolean       @default(false)
  gapCategory     GapCategory?
  gapVerifiedAt   DateTime?
  gapDocumentUrl  String?       // S3 URL of verification doc
  gapVerifiedBy   String?       // staff userId who approved

  // Stripe
  stripeCustomerId String?      @unique

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  household       Household?    @relation(fields: [householdId], references: [id])
  householdId     String?
  isHouseholdPrimary Boolean    @default(false)

  memberships     Membership[]
  checkIns        CheckIn[]
  progress        ProgressEntry[]
  bookings        ClassBooking[]

  @@index([status])
  @@index([stripeCustomerId])
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING       // GAP verification pending
  LEAD
  VISITOR
}

enum GapCategory {
  VETERAN
  ACTIVE_DUTY
  GUARD_RESERVE
  FIRST_RESPONDER
  MEDICAL_STUDENT
  CLERGY
}

model Household {
  id        String   @id @default(cuid())
  name      String   // e.g. "Brown Family"
  createdAt DateTime @default(now())

  members   Member[]
  
  // Billing cap enforcement
  monthlyCap Int     @default(200) // $200 in dollars
}

// ─── MEMBERSHIPS & BILLING ──────────────────────────────────────────────────

model MembershipPlan {
  id                String   @id @default(cuid())
  name              String   // e.g. "Base Membership"
  slug              String   @unique
  description       String?
  monthlyPrice      Int      // in cents (10000 = $100)
  addOnPrice        Int      @default(5000) // family add-on per member, cents
  householdCap      Int      @default(20000) // $200 cap in cents
  stripePriceId     String?  // Stripe Price ID
  isGap             Boolean  @default(false)
  isActive          Boolean  @default(true)
  requiresApproval  Boolean  @default(false) // GAP plans need staff approval
  sortOrder         Int      @default(0)

  memberships Membership[]
}

model Membership {
  id                  String           @id @default(cuid())
  memberId            String
  planId              String
  status              SubscriptionStatus @default(ACTIVE)
  stripeSubscriptionId String?         @unique
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  cancelAtPeriodEnd   Boolean          @default(false)
  canceledAt          DateTime?
  createdAt           DateTime         @default(now())
  soldBy              String?          // staff userId

  member Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan   MembershipPlan @relation(fields: [planId], references: [id])

  @@index([memberId])
  @@index([stripeSubscriptionId])
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
  PAUSED
  UNPAID
}

// ─── CLASSES & SCHEDULING ───────────────────────────────────────────────────

model ClassType {
  id          String   @id @default(cuid())
  name        String   // e.g. "Strength & Conditioning"
  description String?
  color       String   @default("#000000") // calendar color
  duration    Int      @default(60) // minutes
  isActive    Boolean  @default(true)

  sessions ClassSession[]
}

model ClassSession {
  id            String    @id @default(cuid())
  classTypeId   String
  instructorId  String?
  startTime     DateTime
  endTime       DateTime
  capacity      Int       @default(12)
  location      String?
  notes         String?
  isCanceled    Boolean   @default(false)
  cancelReason  String?

  classType   ClassType     @relation(fields: [classTypeId], references: [id])
  instructor  Staff?        @relation(fields: [instructorId], references: [id])
  bookings    ClassBooking[]

  @@index([startTime])
}

model ClassBooking {
  id         String        @id @default(cuid())
  sessionId  String
  memberId   String
  status     BookingStatus @default(CONFIRMED)
  checkedIn  Boolean       @default(false)
  createdAt  DateTime      @default(now())

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member  Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([sessionId, memberId])
}

enum BookingStatus {
  CONFIRMED
  WAITLISTED
  CANCELED
  NO_SHOW
}

// ─── CHECK-IN ───────────────────────────────────────────────────────────────

model CheckIn {
  id        String   @id @default(cuid())
  memberId  String
  checkedAt DateTime @default(now())
  method    String   @default("manual") // "qr", "manual", "kiosk"
  staffId   String?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([checkedAt])
}

// ─── PROGRESS TRACKING ──────────────────────────────────────────────────────

model ProgressEntry {
  id          String   @id @default(cuid())
  memberId    String
  recordedAt  DateTime @default(now())
  
  // Body metrics
  weight      Float?   // lbs
  bodyFat     Float?   // %
  
  // Measurements (inches)
  chest       Float?
  waist       Float?
  hips        Float?
  bicepL      Float?
  bicepR      Float?
  thighL      Float?
  thighR      Float?
  
  // Performance PRs
  benchPress  Float?
  squat       Float?
  deadlift    Float?
  pullUps     Int?
  pushUps     Int?
  runMile     Float?   // minutes
  
  notes       String?  @db.Text

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, recordedAt])
}

model ProgressPhoto {
  id         String   @id @default(cuid())
  memberId   String
  url        String   // S3 URL
  takenAt    DateTime @default(now())
  angle      String?  // "front", "side", "back"
  notes      String?

  @@index([memberId])
}

// ─── STAFF ──────────────────────────────────────────────────────────────────

model Staff {
  id          String   @id @default(cuid())
  userId      String   @unique
  firstName   String
  lastName    String
  title       String?  // "Head Trainer", "Coach", etc.
  bio         String?  @db.Text
  photoUrl    String?
  isActive    Boolean  @default(true)

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions ClassSession[]
}

// ─── CONTENT ────────────────────────────────────────────────────────────────

model Post {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  content     String     @db.Text
  excerpt     String?    @db.Text
  featuredImage String?
  category    PostCategory
  status      PostStatus @default(PUBLISHED)
  publishedAt DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([category, status])
}

enum PostCategory {
  CORE_VALUES
  HERO_TREE
  MEDIA
  FITNESS
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model Event {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  description String?     @db.Text
  featuredImage String?
  startDate   DateTime
  endDate     DateTime?
  location    String?
  externalUrl String?
  status      EventStatus @default(PUBLISHED)
  createdAt   DateTime    @default(now())
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELED
}

model HeroTreeEntry {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  branch      String?  // "USMC", "Army", "Law Enforcement", etc.
  rank        String?
  hometown    String?
  unit        String?
  dod         DateTime? // date of death
  content     String   @db.Text
  photoUrl    String?
  status      PostStatus @default(PUBLISHED)
}
