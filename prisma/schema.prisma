generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique   // optional for minor/username-only accounts
  username      String?   @unique   // for minors logging in without email
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  role          Role      @default(MEMBER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  member        Member?
  sessions      Session[]
  staff         Staff?
  pushSubs      PushSubscription[]
}

model Member {
  id                 String          @id @default(cuid())
  userId             String?         @unique  // null for minors and portal-less members
  firstName          String
  lastName           String
  phone              String?
  phone2             String?
  email2             String?
  dateOfBirth        DateTime?
  address            String?
  city               String?
  state              String?
  zip                String?
  gender             String?
  gymDeskId          String?
  checkInCode        String?         @unique
  memberCode         String?         @unique  // 4-digit kiosk ID (MMYY default)
  memberPinHash      String?                  // bcrypt hash of 4-digit PIN
  source             String?
  notes              String?
  joinedAt           DateTime        @default(now())
  lastVisit          DateTime?
  status             MemberStatus    @default(ACTIVE)
  isMinor            Boolean         @default(false)  // set from DOB at creation; no portal login
  accessLevel        AccessLevel     @default(FULL)   // enforced at booking time
  gapEligible        Boolean         @default(false)
  gapCategory        GapCategory?
  gapVerifiedAt      DateTime?
  gapDocumentUrl     String?
  gapVerifiedBy      String?
  stripeCustomerId   String?         @unique
  photoUrl           String?                          // S3 URL for member profile photo
  householdId        String?
  isHouseholdPrimary Boolean         @default(false)
  billingStartDate   DateTime?                        // For MIGRATING members: when Stripe billing begins
  gymDeskLastBilled  DateTime?                        // Last GymDesk payment date
  classCredits       Int             @default(0)              // prepaid drop-in / 10-pack credits
  referredById       String?
  preferredCoachId   String?
  referredBy         Member?         @relation("MemberReferrals", fields: [referredById], references: [id])
  referrals          Member[]        @relation("MemberReferrals")
  coachNotes         CoachNote[]
  goals              MemberGoal[]
  checkIns           CheckIn[]
  bookings           ClassBooking[]
  household          Household?      @relation(fields: [householdId], references: [id])
  user               User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  memberships        Membership[]
  progress           ProgressEntry[]
  onboarding         MemberOnboarding?
  journeyCheckIns    JourneyCheckIn[]
  milestones         Milestone[]
  coreMetrics        CoreMetrics[]
  kioskPurchases     KioskPurchase[]
  kioskMessages      KioskMessage[]
  messageThreads     MessageThread[]
  recurringBookings  RecurringBooking[]
  corporateEmployee  CorporateEmployee?

  @@index([status])
  @@index([stripeCustomerId])
  @@index([referredById])
  @@index([memberCode])
}

model Household {
  id         String   @id @default(cuid())
  name       String
  createdAt  DateTime @default(now())
  monthlyCap Int      @default(200)
  members    Member[]
}

model MembershipPlan {
  id               String       @id @default(cuid())
  name             String
  slug             String       @unique
  description      String?
  monthlyPrice     Int
  addOnPrice       Int          @default(5000)
  householdCap     Int          @default(20000)
  stripePriceId    String?
  isGap            Boolean      @default(false)
  isActive         Boolean      @default(true)
  requiresApproval Boolean      @default(false)
  sortOrder        Int          @default(0)
  memberships      Membership[]
}

model Membership {
  id                   String             @id @default(cuid())
  memberId             String
  planId               String
  status               SubscriptionStatus @default(ACTIVE)
  stripeSubscriptionId String?            @unique
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  createdAt            DateTime           @default(now())
  soldBy               String?
  member               Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan                 MembershipPlan     @relation(fields: [planId], references: [id])

  @@index([memberId])
  @@index([stripeSubscriptionId])
}

model ClassType {
  id             String         @id @default(cuid())
  name           String         @unique
  description    String?
  color          String         @default("#000000")
  duration       Int            @default(60)
  isActive       Boolean        @default(true)
  accessCategory ClassCategory  @default(FULL_ACCESS)  // who can book this
  sessions       ClassSession[]
  scheduleSlots  ScheduleSlot[]
}

enum ClassCategory {
  FULL_ACCESS     // anyone with FULL access (Base/GAP)
  HH              // Homeschool Heroes — HH plan members only
  OPEN_GYM        // Open Gym — all plans can access
  TRIBAL_ELDERS   // Tribal Elders — TE plan only
  FREE_EVENT      // any member can book regardless of plan
}

model ClassSession {
  id             String         @id @default(cuid())
  classTypeId    String
  instructorId   String?
  startTime      DateTime
  endTime        DateTime
  capacity       Int            @default(12)
  location       String?
  scheduleSlotId String?        // references SCHEDULE_DATA[].id in schedule-data.ts
  notes          String?
  isCanceled     Boolean        @default(false)
  cancelReason   String?
  bookings       ClassBooking[]
  classType      ClassType      @relation(fields: [classTypeId], references: [id])
  instructor     Staff?         @relation(fields: [instructorId], references: [id])

  @@index([startTime])
  @@unique([scheduleSlotId, startTime])
}

model ClassBooking {
  id               String        @id @default(cuid())
  sessionId        String
  memberId         String
  status           BookingStatus @default(CONFIRMED)
  waitlistPosition Int?          // null = confirmed, 1+ = waitlisted
  checkedIn        Boolean       @default(false)
  createdAt        DateTime      @default(now())
  member           Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  session          ClassSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, memberId])
}

model CheckIn {
  id        String   @id @default(cuid())
  memberId  String
  checkedAt DateTime @default(now())
  method    String   @default("manual")
  staffId   String?
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([checkedAt])
}

model ProgressEntry {
  id         String   @id @default(cuid())
  memberId   String
  recordedAt DateTime @default(now())
  weight     Float?
  bodyFat    Float?
  chest      Float?
  waist      Float?
  hips       Float?
  bicepL     Float?
  bicepR     Float?
  thighL     Float?
  thighR     Float?
  benchPress Float?
  squat      Float?
  deadlift   Float?
  pullUps    Int?
  pushUps    Int?
  runMile    Float?
  notes      String?
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, recordedAt])
}

model ProgressPhoto {
  id       String   @id @default(cuid())
  memberId String
  url      String
  takenAt  DateTime @default(now())
  angle    String?
  notes    String?

  @@index([memberId])
}

model CoachNote {
  id        String   @id @default(cuid())
  memberId  String
  coachId   String
  content   String
  isPrivate Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  coach     Staff    @relation(fields: [coachId], references: [id])

  @@index([memberId])
  @@index([coachId])
}

model MemberGoal {
  id          String    @id @default(cuid())
  memberId    String
  setByCoach  String?
  title       String
  description String?
  targetDate  DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  milestones  Milestone[]

  @@index([memberId])
}

model Staff {
  id        String         @id @default(cuid())
  userId    String         @unique
  firstName String
  lastName  String
  title     String?
  bio       String?
  photoUrl  String?
  isActive  Boolean        @default(true)
  sessions  ClassSession[]
  coachNotes CoachNote[]
  messageThreads MessageThread[] @relation("CoachThreads")
  scheduleSlots  ScheduleSlot[]  @relation("StaffScheduleSlots")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id            String       @id @default(cuid())
  title         String
  slug          String       @unique
  content       String
  excerpt       String?
  featuredImage String?
  category      PostCategory
  status        PostStatus   @default(PUBLISHED)
  publishedAt   DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([category, status])
}

model Event {
  id            String      @id @default(cuid())
  title         String
  slug          String      @unique
  description   String?
  featuredImage String?
  startDate     DateTime
  endDate       DateTime?
  location      String?
  externalUrl   String?
  status        EventStatus @default(DRAFT)
  createdAt     DateTime    @default(now())

  // Overview
  cost              String?
  deadline          DateTime?
  collaborators     String?

  // Logistics
  permitRequired    Boolean?
  permitApplied     DateTime?
  permitApproved    DateTime?
  equipmentRequired String?

  // Checklists (stored as JSON arrays/objects)
  imageAssets       Json?   // { poster: bool, banner: bool, square: bool, vertical: bool, runsignupBanner: bool, facebookBanner: bool, eventbriteBanner: bool }
  postingChannels   Json?   // { eventsPage: bool, facebookEvents: bool, eventbrite: bool, runsignup: bool, fredericksburgFreePress: bool, lakeAnnaGuide: bool, rallyPoint: bool, allEventsIn: bool, teamRwbApp: bool, goruck: bool, scso: bool, fxbgNeighbors: bool, newsletter: bool, radioEvents: bool, gymDesk: bool }
  bookingLinks      Json?   // { gymDesk: bool, runSignUp: bool, facebook: bool, eventbrite: bool }

  // Financial tables (JSON arrays of rows)
  operationalCosts  Json?   // [{ type, source, required, budget, cost }]
  marketingPlan     Json?   // [{ type, description, beginDate, endDate, budget, location }]
  sponsorships      Json?   // [{ type, sponsor, fee, due, paid }]
  attendance        Json?   // [{ type, source, ipa, projected, actual }]

  // After action
  afterActionNotes  String?
  finalCba          Json?   // { firstTime, returning, sponsors, vendors, partners, totalAttendance, volunteersPresent, volunteersRecruited, mentorSignups, menteeSignups, ysaRegistrations, contactRegistrations, sponsorshipIncome, eventRegistration, donationsPrior, donationsDuring, foodRaffleIncome, totalIncome }
}

model HeroTreeEntry {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  branch   String?
  rank     String?
  hometown String?
  unit     String?
  dod      DateTime?
  content  String
  photoUrl String?
  status   PostStatus @default(PUBLISHED)
}

enum Role {
  MEMBER
  STAFF
  COACH
  ADMIN
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
  LEAD
  VISITOR
  MIGRATING
}

enum AccessLevel {
  FULL               // Base, GAP — all classes
  HH_AND_OG          // HH plan — Homeschool Heroes + Open Gym only
  TRIBAL_ELDERS_ONLY // Tribal Elders plan — TE programming only
  OPEN_GYM_ONLY      // Open Gym standalone
}

enum GapCategory {
  VETERAN
  ACTIVE_DUTY
  GUARD_RESERVE
  FIRST_RESPONDER
  MEDICAL_STUDENT
  CLERGY
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
  PAUSED
  UNPAID
}

enum BookingStatus {
  CONFIRMED
  WAITLISTED
  CANCELED
  NO_SHOW
}

enum PostCategory {
  CORE_VALUES
  HERO_TREE
  MEDIA
  FITNESS
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELED
}

// ── F3 — Foster Families Free ─────────────────────────────────────────────────
model F3Application {
  id                    String   @id @default(cuid())
  createdAt             DateTime @default(now())
  firstName             String
  lastName              String
  email                 String
  phone                 String
  address               String
  city                  String
  state                 String
  zip                   String
  numberOfFosterChildren Int
  fosteringDuration     String   // e.g. "Less than 1 year", "1-3 years", etc.
  agencyName            String?
  heardAboutUs          String?
  additionalNotes       String?
  status                String   @default("pending") // pending, approved, denied
}

// ── Push Notifications ────────────────────────────────────────────────────────
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Member Onboarding ─────────────────────────────────────────────────────────
model MemberOnboarding {
  id                 String    @id @default(cuid())
  memberId           String    @unique
  completedAt        DateTime?
  currentStep        Int       @default(1)
  // Intake
  reasonsForJoining  String?
  daysPerWeek        Int?
  preferredDays      String?   // JSON array e.g. ["MON","WED","FRI"]
  preferredTime      String?   // MORNING | AFTERNOON | EVENING
  priorTraining      Boolean?
  priorTrainingNotes String?
  injuries           String?
  // Goals
  whatNotWorking     String?
  vision90Days       String?
  whyImportant       String?
  goalStatement      String?
  // Nutrition baseline
  proteinGoalG       Int?
  waterGoalOz        Int?      @default(100)
  member             Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

// ── 30/60/90 Journey Check-Ins ────────────────────────────────────────────────
model JourneyCheckIn {
  id                String          @id @default(cuid())
  memberId          String
  type              CheckInType
  scheduledDate     DateTime
  memberCompletedAt DateTime?
  coachCompletedAt  DateTime?
  // Member self-assessment
  bigWins           String?
  areasToImprove    String?
  effortRating      Int?            // 1-10
  motivationNote    String?
  // Metrics snapshot (mirrors ProgressEntry fields)
  weight            Float?
  bodyFat           Float?
  muscleMass        Float?
  // Upsell flags (coach fills)
  nutritionProgram  Boolean?
  mobilityProgram   Boolean?
  personalTraining  Boolean?
  coachNotes        String?
  // Referral captured at Day 30
  referralName      String?
  // Social media review captured at Day 60
  socialReviewUrl   String?
  // Testimonial captured at Day 90
  testimonial       String?
  member            Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([scheduledDate])
}

// ── Milestone / Win Tracker ───────────────────────────────────────────────────
model Milestone {
  id          String        @id @default(cuid())
  memberId    String
  goalId      String?
  type        MilestoneType
  title       String
  description String?
  targetValue Float?
  unit        String?       // "lbs", "%", "reps", etc.
  achievedAt  DateTime?
  awardedBy   String?       // staffId if coach-awarded, null if auto
  createdAt   DateTime      @default(now())
  member      Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  goal        MemberGoal?   @relation(fields: [goalId], references: [id])

  @@index([memberId])
}

enum CheckInType {
  DAY1
  DAY30
  DAY60
  DAY90
  DAY180
}

enum MilestoneType {
  WEIGHT_LOSS_PCT    // % toward weight loss goal
  WEIGHT_GAIN_PCT    // % toward weight gain goal
  LIFT_PR            // New personal record on a lift
  BODY_FAT_PCT       // Body fat % milestone
  ATTENDANCE         // Consecutive sessions / total visits
  HABIT              // Coach-awarded habit milestone
  CUSTOM             // Free-form coach award
}

// ── Core Metrics (formal assessments) ────────────────────────────────────────
// One row per evaluation. Linked to a member + optionally to a JourneyCheckIn.
// Used for onboarding baseline, 90-day, 180-day, and ongoing assessments.
model CoreMetrics {
  id            String      @id @default(cuid())
  memberId      String
  checkInId     String?     // optional link to the JourneyCheckIn that triggered this
  assessmentType AssessmentType @default(ONGOING)
  recordedAt    DateTime    @default(now())
  recordedBy    String?     // staffId of the coach who recorded it (null = self-reported)

  // ── Demographics (stable / slow-changing) ──────────────────────────────────
  age           Int?        // years
  heightIn      Float?      // height in inches (display as ft/in)

  // ── Body Composition ───────────────────────────────────────────────────────
  weightLbs     Float?      // lbs
  bodyFatPct    Float?      // %

  // ── Strength — 1RM ────────────────────────────────────────────────────────
  squatLbs      Float?      // back squat 1RM, lbs
  benchLbs      Float?      // bench press 1RM, lbs
  deadliftLbs   Float?      // deadlift 1RM, lbs

  // ── Cardio ────────────────────────────────────────────────────────────────
  mileSec       Int?        // 1-mile run time, seconds  (display as MM:SS)
  fourHundredSec Int?       // 400m run time, seconds    (display as MM:SS)

  // ── Baseline WOD ──────────────────────────────────────────────────────────
  // 500m row → 40 air squats → 30 sit-ups → 20 push-ups (for time) + max pull-up reps
  wodTimeSec    Int?        // total WOD time, seconds   (display as MM:SS)
  wodPullUps    Int?        // max pull-up reps immediately after WOD

  notes         String?

  member        Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, recordedAt])
  @@index([memberId, assessmentType])
}

enum AssessmentType {
  ONBOARDING   // Day 1 intake baseline
  DAY90        // 90-day formal evaluation
  DAY180       // 180-day formal evaluation
  ONGOING      // Coach or member-logged anytime
}

// ── Kiosk ─────────────────────────────────────────────────────────────────────
model KioskProduct {
  id          String          @id @default(cuid())
  name        String
  description String?
  priceCents  Int
  imageUrl    String?
  inStock     Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  purchases   KioskPurchase[]
}

model KioskPurchase {
  id                    String        @id @default(cuid())
  memberId              String
  productId             String
  quantity              Int           @default(1)
  priceCents            Int           // snapshot at time of purchase
  notes                 String?       // e.g. tumbler personalization text
  stripePaymentIntentId String?       // set when charged via stored card
  purchasedAt           DateTime      @default(now())
  settledAt             DateTime?     // null = tab open / pending payment
  member                Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  product               KioskProduct  @relation(fields: [productId], references: [id])

  @@index([memberId])
  @@index([purchasedAt])
}

model KioskMessage {
  id         String    @id @default(cuid())
  memberId   String
  message    String
  sentAt     DateTime  @default(now())
  readAt     DateTime?
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([sentAt])
}

// ── Contact Form (public visitors) ───────────────────────────────────────────
model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  sentAt    DateTime  @default(now())
  readAt    DateTime?
  repliedAt DateTime?

  @@index([sentAt])
}

// ── Member ↔ Coach Messaging ──────────────────────────────────────────────────
model MessageThread {
  id        String         @id @default(cuid())
  memberId  String
  coachId   String?        // null = any coach / admin; set = specific coach's inbox
  subject   String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  member    Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  coach     Staff?         @relation("CoachThreads", fields: [coachId], references: [id])
  entries   MessageEntry[]

  @@index([memberId])
  @@index([updatedAt])
  @@index([coachId])
}

model MessageEntry {
  id          String        @id @default(cuid())
  threadId    String
  senderType  SenderType
  senderName  String
  body        String
  sentAt      DateTime      @default(now())
  readAt      DateTime?
  thread      MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([sentAt])
}

enum SenderType {
  MEMBER
  COACH
}

model ScheduleSlot {
  id          String    @id @default(cuid())
  slotKey     String    @unique       // matches legacy schedule-data.ts id (s1, og1, etc.)
  classTypeId String
  instructorId String?
  startHour   Int
  startMinute Int
  durationMin Int
  days        Int[]                   // 0=Sun … 6=Sat
  capacity    Int       @default(12)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  classType   ClassType @relation(fields: [classTypeId], references: [id])
  instructor  Staff?    @relation("StaffScheduleSlots", fields: [instructorId], references: [id])

  @@index([isActive])
  @@index([instructorId])
}

// Member sets "I want s1 every Mon/Wed/Fri forever" — cron auto-books sessions
model RecurringBooking {
  id        String   @id @default(cuid())
  memberId  String
  slotId    String   // references schedule-data slot id (e.g. "s1")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, slotId])
  @@index([memberId])
  @@index([slotId])
}

// ── Corporate Wellness ────────────────────────────────────────────────────────

model CorporateAccount {
  id                  String                @id @default(cuid())
  companyName         String
  contactFirstName    String
  contactLastName     String
  contactEmail        String                @unique
  contactPhone        String?
  planTier            CorporateTier         @default(SMALL)   // drives pricing & seat cap
  stripeCustomerId    String?               @unique
  stripeSubscriptionId String?              @unique
  status              CorporateStatus       @default(PENDING)
  billingStartDate    DateTime?
  seatCount           Int                   @default(0)       // live count synced on enroll
  notes               String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  employees           CorporateEmployee[]
}

model CorporateEmployee {
  id                  String                @id @default(cuid())
  accountId           String
  firstName           String
  lastName            String
  email               String
  inviteToken         String?               @unique           // UUID sent in onboarding email
  inviteExpiresAt     DateTime?
  inviteAcceptedAt    DateTime?
  memberId            String?               @unique           // set once they complete onboarding
  status              CorporateEmployeeStatus @default(INVITED)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  account             CorporateAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  member              Member?               @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([inviteToken])
  @@index([email])
}

enum CorporateTier {
  SMALL   // up to 5 employees  — $250/mo
  MEDIUM  // up to 15 employees — $750/mo
  LARGE   // up to 50 employees — $2500/mo
}

enum CorporateStatus {
  PENDING   // account created, billing not yet set up
  ACTIVE
  PAUSED
  CANCELED
}

enum CorporateEmployeeStatus {
  INVITED       // email sent, not yet accepted
  ONBOARDING    // clicked link, in progress
  ACTIVE        // member record created & linked
  REMOVED       // removed from account
}

// Booth / event promo leads
model BoothLead {
  id             String   @id @default(cuid())
  firstName      String
  lastName       String
  email          String
  phone          String
  dateOfBirth    DateTime?
  waiverSigned   Boolean  @default(true)
  marketingOptIn Boolean  @default(true)
  notes          String?
  source         String   @default("booth")
  createdAt      DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}
